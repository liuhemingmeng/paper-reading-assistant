# Copy this file to .env and fill in real values locally.
# Generic JSON API script settings
API_BASE_URL=https://example.com/api
API_KEY=replace-me

# OpenAI-compatible LLM settings for RAG answering + reading insights.
# Defaults to Volcano deepseek-v4-flash; switch LLM_MODEL to any reachable
# model from model_registry.get_llm_specs() (e.g. siliconflow-deepseek-v3.2).
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-v4-flash-260425

# Separate keys for the two LLM providers (provisioned independently from the
# embedding keys). Used by model_registry.get_llm_specs().
VOLCANO_LLM_API_KEY=replace-me
SILICONFLOW_LLM_API_KEY=replace-me

# OpenAI-compatible embedding settings for retrieval (optional)
# Leave EMBEDDING_BASE_URL/API_KEY/MODEL unset to use the local hashing baseline.
# Set all three to switch the retrieval index to a real embedding model.
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=replace-with-your-embedding-model-name
# Endpoint path appended to EMBEDDING_BASE_URL. Default "/embeddings".
# Volcano Engine multimodal models (e.g. doubao-embedding-vision-*) need "/embeddings/multimodal".
EMBEDDING_ENDPOINT=/embeddings

# SiliconFlow embedding + reranker key (Qwen3 / bge-m3 family).
# Used by model_registry.py and scripts/smoke_models.py for the multi-model benchmark.
# SiliconFlow embedding endpoint is OpenAI-compatible (https://api.siliconflow.cn/v1/embeddings);
# reranker endpoint is https://api.siliconflow.cn/v1/rerank.
# NOTE: the SiliconFlow *chat* key is a different token (SILICONFLOW_LLM_API_KEY, see above).
SILICONFLOW_API_KEY=replace-me
