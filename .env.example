# ============================================================
# 仓库默认配置模板（复制为 .env 即可运行：cp .env.example .env）
#
# 注意：本仓库不内置真实密钥（GitHub push protection 会拦截密钥提交）。
# 你本机的 .env 已内置真实演示密钥，可直接 `python -m paper_api` 一键运行；
# 云服务器 /opt/rag/.env 同样内置真实密钥。本文件只作为格式模板。
#
# 默认生产路径：
#   - embedding 默认 BAAI/bge-m3（硅基流动）
#   - LLM 默认 deepseek-v4-flash（火山方舟）
#   - rerank 默认关闭，RERANKER_ENABLED=true 开启（同一硅基 key）
# ============================================================

# Generic JSON API script settings
API_BASE_URL=https://example.com/api
API_KEY=replace-me

# OpenAI-compatible LLM settings for RAG answering + reading insights.
# 默认 Volcano deepseek-v4-flash（生产 RAG 模型）。
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-v4-flash-260425

# 两个 LLM 服务商的独立 key（与 embedding key 分开发放）。供 model_registry 基准用。
VOLCANO_LLM_API_KEY=replace-me
SILICONFLOW_LLM_API_KEY=replace-me

# OpenAI-compatible embedding settings for retrieval（默认生产路径 = bge-m3）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=BAAI/bge-m3
# 拼到 EMBEDDING_BASE_URL 后的端点路径，默认 /embeddings。
EMBEDDING_ENDPOINT=/embeddings

# SiliconFlow key（rerank 可选功能复用同一把 key）
SILICONFLOW_API_KEY=replace-me

# 可选 reranker（两阶段检索）。默认关闭；设 RERANKER_ENABLED=true 开启。
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_ENABLED=false

# 本地 API 鉴权 key：留空 = 开放（本地演示免 key 直接访问）。
RAG_API_KEY=

# 访问密钥轮换管理员密钥（POST /admin/rotate-key 需要）。
# 生产环境务必设置为强随机串，仅所有者知晓；本地演示可留空。
ADMIN_KEY=
